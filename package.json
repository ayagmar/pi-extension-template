{
  "name": "my-pi-extension",
  "version": "0.1.0",
  "description": "Starter template for building robust Pi extensions",
  "keywords": [
    "pi-package",
    "pi-extension",
    "template"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "starters/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "setup-template": "node ./scripts/setup.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke-test": "node --import=tsx ./scripts/smoke-test.mjs",
    "test": "node --import=tsx --test ./test/*.test.ts",
    "check": "npm run typecheck && npm run smoke-test && npm run test && npm run lint && npm run format:check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://placehold.co/1200x630/png?text=My+Pi+Extension"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.52.8",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^22.19.10",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
