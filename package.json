{
  "name": "my-pi-extension",
  "version": "0.1.0",
  "description": "Starter template for building robust Pi extensions",
  "keywords": [
    "pi-package",
    "pi-extension",
    "template"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "files": [
    "src/",
    "starters/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "setup-template": "node ./scripts/setup.mjs",
    "lint": "biome lint . --error-on-warnings",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke-test": "node --import=tsx ./scripts/smoke-test.mjs",
    "test": "node --import=tsx --test ./test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json && node --import=tsx ./scripts/smoke-test.mjs && node --import=tsx --test ./test/*.test.ts && pnpm run lint && pnpm run format:check"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "image": "https://placehold.co/1200x630/png?text=My+Pi+Extension"
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@mariozechner/pi-ai": "^0.63.1",
    "@mariozechner/pi-coding-agent": "^0.63.1",
    "@mariozechner/pi-tui": "^0.63.1",
    "@sinclair/typebox": "^0.34.48",
    "@types/node": "^22.19.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
